{
  "service_name": "rootfall-engine",
  "framework": "ROOTFALL",
  "version": "2.2.0",
  "author": "Haxhijaha, Agim",
  "orcid": "0009-0002-3234-7765",
  "minimum_viable_deployment": {
    "compute": "2 vCPU",
    "memory": "1-2 GiB",
    "storage": "10 GiB SSD",
    "network": "HTTPS ingress + private VPC for inter-service mTLS"
  },
  "dependencies": [
    "Python 3.11+ stdlib runtime (reference PoC)",
    "structured JSON log sink",
    "TLS-terminating reverse proxy"
  ],
  "environment_variables": [
    "ROOTFALL_ENV=staging|production",
    "ROOTFALL_LOG_LEVEL=INFO",
    "ROOTFALL_AUDIT_PATH=/var/log/rootfall-engine",
    "ROOTFALL_MAX_BATCH=1000"
  ],
  "health_check_endpoint": "/health",
  "api_base_path": "/api/v1/rootfall",
  "estimated_latency_p99": "20-100ms p99 (100-path ablation)",
  "estimated_throughput": "100-300 certificate jobs/min",
  "scaling_model": "horizontal",
  "security_requirements": [
    "TLS 1.3",
    "mTLS for inter-service",
    "signed audit events",
    "least-privilege service account"
  ],
  "monitoring": {
    "metrics": [
      "request_latency_ms",
      "jobs_completed_total",
      "error_rate",
      "peak_memory_mb",
      "bottleneck_proxy:build"
    ],
    "alerts": [
      "p99_latency > 2x baseline",
      "error_rate > 1%",
      "memory > 80% of limit"
    ],
    "log_format": "structured JSON"
  },
  "stress_basis": {
    "1x_total_seconds": 0.00519,
    "1x_peak_mb": 0.2698,
    "bottleneck_operation": "build",
    "note": "Pairwise independence / ablation scales with paths\u00d7roots"
  },
  "estimated_monthly_cost_usd": "$40-120/month",
  "disclaimer": "Order-of-magnitude estimates from PoC stress tests; not a vendor quote."
}